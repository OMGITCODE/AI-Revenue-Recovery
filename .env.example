# ── Razorpay (required for live mode) ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── Logging ────────────────────────────────────────────────────────────────────
# LOG_LEVEL options: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO
# LOG_FORMAT options: console (coloured, default) | json (for log aggregators)
LOG_FORMAT=console

# ── Optional: WhatsApp / Notifications ─────────────────────────────────────────
# Uncomment and fill in when adding real WhatsApp integration (Interakt/Wati)
# WHATSAPP_API_KEY=
# WHATSAPP_PHONE_NUMBER_ID=

# ── Optional: OpenAI (for future LLM diagnoser feature) ───────────────────────
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
