# ── Razorpay (required for live mode) ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── Logging ────────────────────────────────────────────────────────────────────
# LOG_LEVEL options: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO
# LOG_FORMAT options: console (coloured, default) | json (for log aggregators)
LOG_FORMAT=console

# ── WhatsApp / SMS (Twilio) ───────────────────────────────────────────────────
# Blank = mock mode (default). Every intervention still "sends", it just logs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio's shared Sandbox number
TWILIO_SMS_FROM=
# Optional: route every LIVE send here instead of the demo dataset's fake
# numbers, so anyone running the repo actually receives it on a real phone.
DEMO_RECIPIENT_WHATSAPP=whatsapp:+91XXXXXXXXXX
DEMO_RECIPIENT_SMS=+91XXXXXXXXXX

# ── Local Webhook Tunneling (ngrok) for Live Twilio Testing ───────────────────
# To test 2-way live WhatsApp webhooks locally:
# 1. Start server:   python -X utf8 -m uvicorn api.main:app --port 8000 --reload
# 2. Expose tunnel:  ngrok http 8000
# 3. In Twilio Console -> Messaging -> Try WhatsApp -> Sandbox Settings:
#    Set "WHEN A MESSAGE COMES IN" URL to:
#    https://<your-ngrok-subdomain>.ngrok-free.app/api/webhook/whatsapp/twilio
#    (Method: HTTP POST)

# ── Optional: OpenAI (for future LLM diagnoser feature) ───────────────────────
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o

# ── App & Security ─────────────────────────────────────────────────────────────
APP_ENV=development

# Optional: Set an API key to lock down mutating/control endpoints in production.
# In development / demo mode (blank), the dashboard and demo scripts run without auth friction.
RECOVERIQ_API_KEY=

# Allowed CORS origins (comma-separated). Default "*" for development.
# Example for production: https://app.recoveriq.ai,https://admin.recoveriq.ai
CORS_ORIGINS=*

